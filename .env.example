# Copy to .env (chmod 600). CLI values are literal. Existing environment overrides the file.
MEDIA_BOT_DATA=/srv/telegram/data
MEDIA_BOT_SECRET_DIR=/srv/telegram/credentials
MEDIA_BOT_SECRET_SOCKET=/srv/telegram/run/broker.sock
MEDIA_BOT_ORIGIN=https://telegram.example.org
MEDIA_BOT_BASE=/
MEDIA_BOT_WEB_PORT=8091
MEDIA_BOT_ADMIN_USER=sena
# Generate with python -m media_bot.admin_auth.
MEDIA_BOT_ADMIN_PASSWORD_HASH=
# Numeric Telegram ID of the bot owner.
MEDIA_BOT_OWNER_ID=
# Paste the BotFather token here or configure it in the web console.
TELEGRAM_BOT_TOKEN=
# Optional local Bot API and upload acceleration.
# MEDIA_BOT_API_BASE=http://127.0.0.1:8081
# MEDIA_BOT_LOCAL_FILE_UPLOADS=1
# Optional Linux filesystem identity guard.
# MEDIA_BOT_STORAGE_UUID=
# Each provider has its own user and control socket.
# MEDIA_BOT_PUSH_SOCKET=/srv/telegram/run/push.sock
# MEDIA_BOT_PUSH_PROVIDERS='{"news":{"uid":2001,"control":"/srv/news/run/subscriptions.sock"}}'
