[Unit]
Description=Telegram Social Downloader push
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/telegram-social-downloader
Requires=telegram-social-broker.service
After=telegram-social-broker.service

[Service]
User=telegram-social
Group=telegram-push
SupplementaryGroups=telegram-social telegram-push
RuntimeDirectory=telegram-social-push
RuntimeDirectoryMode=0750
WorkingDirectory=/opt/telegram-social-downloader/current
EnvironmentFile=/etc/telegram-social-downloader/.env
Environment=TMPDIR=/var/lib/telegram-social-downloader/tmp/push
ExecStart=/opt/telegram-social-downloader/current/.venv/bin/python -m media_bot push
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
KillMode=control-group
UMask=0077
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
LimitCORE=0
ReadWritePaths=/var/lib/telegram-social-downloader

[Install]
WantedBy=multi-user.target
